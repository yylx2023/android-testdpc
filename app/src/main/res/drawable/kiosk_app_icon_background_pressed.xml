<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- 按下状态 -->
    <item android:state_pressed="true">
        <shape android:shape="oval">
            <gradient
                    android:angle="135"
                    android:startColor="#E0E7F0"
                    android:centerColor="#D0DAE8"
                    android:endColor="#C0CDD8"
                    android:type="linear" />
            <stroke
                    android:width="2dp"
                    android:color="#A8B8CC" />
        </shape>
    </item>

    <!-- 聚焦状态 -->
    <item android:state_focused="true">
        <shape android:shape="oval">
            <gradient
                    android:angle="135"
                    android:startColor="#E8F5E9"
                    android:centerColor="#C8E6C9"
                    android:endColor="#A5D6A7"
                    android:type="linear" />
            <stroke
                    android:width="3dp"
                    android:color="#4CAF50" />
        </shape>
    </item>

    <!-- 默认状态 -->
    <item>
        <shape android:shape="oval">
            <gradient
                    android:angle="135"
                    android:startColor="#F8FAFC"
                    android:centerColor="#EDF2F7"
                    android:endColor="#E2E8F0"
                    android:type="linear" />
            <stroke
                    android:width="1.5dp"
                    android:color="#CBD5E0" />
        </shape>
    </item>

</selector>

