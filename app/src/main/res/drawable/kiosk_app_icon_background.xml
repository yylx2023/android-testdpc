<?xml version="1.0" encoding="utf-8"?>
<shape xmlns:android="http://schemas.android.com/apk/res/android"
        android:shape="oval">
    
    <!-- 渐变背景 -->
    <gradient
            android:angle="135"
            android:startColor="#F5F7FA"
            android:centerColor="#E8EEF5"
            android:endColor="#DFE6F0"
            android:type="linear" />
    
    <!-- 边框 -->
    <stroke
            android:width="1dp"
            android:color="#D0D7E2" />
    
    <!-- 内边距 -->
    <padding
            android:left="8dp"
            android:top="8dp"
            android:right="8dp"
            android:bottom="8dp" />

</shape>

